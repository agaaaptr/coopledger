# Backend — copy to backend/.env (or export in your shell) for local runs.
# Docker Compose users do NOT need this file; compose sets these itself.

# JDBC URL. Local Postgres default matches docker-compose.yml.
# For Neon, use the -pooler connection string in JDBC form:
#   jdbc:postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/coopledger
DB_USERNAME=coopledger
DB_PASSWORD=coopledger

# HS256 signing secret, minimum 32 bytes. Generate one: openssl rand -base64 48
JWT_SECRET=coopledger-dev-only-secret-change-me-0123456789abcdef
